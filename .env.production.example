# Modelo do .env de PRODUÇÃO. Copie para /srv/projgaragem/app/.env no servidor e preencha.
# Nunca commite o .env real: ele guarda senhas.

# --- Essencial ---------------------------------------------------------------
DEBUG=False
# Gere com: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
ALLOWED_HOSTS=exemplo.com.br,www.exemplo.com.br
SITE_URL=https://exemplo.com.br

# --- Banco de dados (PostgreSQL) ---------------------------------------------
# Se a senha tiver caracteres especiais (@ : / # % ?), escreva-os codificados (ex: @ vira %40).
DATABASE_URL=postgres://projgaragem:SENHA@localhost:5432/projgaragem

# --- E-mail (SMTP real) ------------------------------------------------------
# Porta 587 = STARTTLS (padrão). Para porta 465 use EMAIL_PORT=465 e EMAIL_USE_SSL=True.
EMAIL_HOST=smtp.seuprovedor.com.br
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=contato@exemplo.com.br
# Recebe os avisos de garagem atrasada e os e-mails de erro 500.
PLATFORM_ADMIN_EMAIL=

# --- Mercado Pago ------------------------------------------------------------
# Use credenciais de PRODUÇÃO (não as TEST-). O webhook precisa apontar para
# https://exemplo.com.br/billing/webhook/mercadopago/
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PLANO_MENSALIDADE_PADRAO=99.90
DIAS_ATRASO_PARA_AVISO_ADMIN=5

# --- Textos legais -----------------------------------------------------------
PLATAFORMA_NOME=
PLATAFORMA_CNPJ=

# --- Segurança HTTPS (opcional) ----------------------------------------------
# HSTS: comece com 1 hora. Depois de confirmar que o HTTPS está perfeito, suba para 31536000 (1 ano).
# O navegador obedece pelo prazo inteiro, então não comece alto.
SECURE_HSTS_SECONDS=3600

# --- Monitoramento de erros (opcional) ----------------------------------------
# Crie um projeto Django gratuito em sentry.io e cole a DSN aqui. Em branco, não
# manda nada para lugar nenhum (nem em produção) — o app funciona igual sem isso.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
