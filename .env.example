SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=change-me
PLATFORM_ADMIN_EMAIL=admin@example.com
# Depois de tentativas demais no login do /admin/, a próxima exige um código mandado a este
# e-mail (ver dashboard/security.py). Pode ser o mesmo PLATFORM_ADMIN_EMAIL ou outro.
EMAIL_CODIGO_ACESSO_ADMIN=admin@example.com
DIAS_ATRASO_PARA_AVISO_ADMIN=5
SITE_URL=http://localhost:8000
PLATAFORMA_NOME=Farol
PLATAFORMA_CNPJ=
# E-mail de contato nos Termos de Uso/Privacidade (diferente do PLATFORM_ADMIN_EMAIL, que é só uso interno)
PLATAFORMA_EMAIL_CONTATO=contato@example.com

# Em desenvolvimento (DEBUG=True) os e-mails só aparecem no terminal do servidor. Para receber de
# verdade, use ENVIAR_EMAIL_REAL=True e preencha o SMTP abaixo (ex: Gmail com "senha de app":
# smtp.gmail.com, porta 587, usuário = o seu Gmail, DEFAULT_FROM_EMAIL = o mesmo Gmail).
ENVIAR_EMAIL_REAL=False
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=user@example.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=contato@example.com

# Opcional — DSN de um projeto no sentry.io. Em branco, não manda nada (nem aqui, nem em produção).
SENTRY_DSN=

# Landing page (raiz do site) — WhatsApp dos sócios, só dígitos com DDI (ex: 5517999999999). Em branco,
# o botão de WhatsApp da landing leva ao formulário de interesse. LANDING_DEMO_SLUG é a garagem cuja
# vitrine aparece no celular da landing (a segunda aparece na seção de marcas).
PLATAFORMA_WHATSAPP=
PLATAFORMA_WHATSAPP_2=
PLATAFORMA_INSTAGRAM=
LANDING_DEMO_SLUG=lanterna-motos
LANDING_DEMO_SLUG_2=central-motors-demo
